  },
  "devDependencies": {
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.5",
    "@types/node": "^22.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.468.0",
    "html2canvas": "^1.4.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "jsdom": "^25.0.1",
    "playwright": "^1.49.0",
    "tsx": "^4.19.2"
  },
  "engines": { "node": ">=20" }
}
